{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "work_completed", "changed_files", "tests", "error", "next_decision", "discussion_points"],
  "properties": {
    "status": {"type": "string", "enum": ["success", "failed", "blocked", "partial", "discussion"]},
    "work_completed": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "error": {"type": ["string", "null"]},
    "next_decision": {"type": ["string", "null"]},
    "discussion_points": {"type": "array", "items": {"type": "string"}}
  }
}
