{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/cross-harness/harness.schema.json",
  "title": "cross-harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "parent_harness", "runtime_root", "retention_days",
    "auth_cache_hours", "context_threshold_percent", "max_parallel", "max_discussion_rounds",
    "dirty_worktree_policy", "delegate_kinds", "fallback", "roles"
  ],
  "properties": {
    "version": {"const": 1},
    "parent_harness": {"enum": ["claude", "codex"]},
    "mode": {"enum": ["on", "off"]},
    "project_auto_setup": {"type": "boolean"},
    "runtime_root": {"type": "string", "minLength": 1},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "auth_cache_hours": {"type": "integer", "minimum": 1, "maximum": 24},
    "context_threshold_percent": {"type": "integer", "minimum": 40, "maximum": 85},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 5, "default": 4},
    "max_discussion_rounds": {"type": "integer", "minimum": 0, "maximum": 10, "default": 3},
    "dirty_worktree_policy": {"$ref": "#/$defs/dirtyPolicy"},
    "auto_commit": {
      "type": "boolean",
      "default": true,
      "description": "Commit each successful write delegation as one commit. May be overridden per project; runtime handling is added in a later unit."
    },
    "auto_revival": {
      "type": "boolean",
      "default": true,
      "description": "Allow a delegation blocked by a usage limit to continue after the recorded reset time. May be overridden per project; runtime handling is added in a later unit."
    },
    "work_branch_prefix": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?:(?![A-Za-z0-9._-]*\\.lock/)[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)+(?![\\s\\S])",
      "default": "cross-harness/",
      "description": "Global prefix for the branch created when a write delegation starts on a protected branch. Must end in a slash; non-empty components use only ASCII letters, digits, dot, underscore and hyphen, cannot start with dot or hyphen, end with dot or .lock, or contain double dot. Runtime handling is added in a later unit."
    },
    "protected_branches": {
      "$ref": "#/$defs/uniqueStrings",
      "default": ["main", "master"],
      "description": "Branches that never receive automatic commits. May be empty or overridden per project; runtime handling is added in a later unit."
    },
    "delegate_kinds": {"$ref": "#/$defs/globalDelegateKinds"},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "claude": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator", "explorer", "implementer", "implementer_complex", "tester",
        "reviewer", "debugger", "security_reviewer"
      ],
      "properties": {
        "orchestrator": {"$ref": "#/$defs/role"},
        "explorer": {"$ref": "#/$defs/role", "description": "Default max_parallel is 3."},
        "implementer": {"$ref": "#/$defs/role", "description": "Default max_parallel is 3."},
        "implementer_complex": {"$ref": "#/$defs/role"},
        "tester": {"$ref": "#/$defs/role"},
        "reviewer": {"$ref": "#/$defs/role", "description": "Default max_parallel is 2."},
        "debugger": {"$ref": "#/$defs/role"},
        "security_reviewer": {"$ref": "#/$defs/role"}
      }
    },
    "projects": {
      "type": "object",
      "propertyNames": {"pattern": "^(?:/|~[/])"},
      "additionalProperties": {"$ref": "#/$defs/project"}
    }
  },
  "$defs": {
    "dirtyPolicy": {"enum": ["stop", "isolate", "allow", "allow_delegated"]},
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!refs/)[^*?\\[\\]\\s]+$"},
      "description": "Entries are literal short branch names, without globs, whitespace or a refs/ prefix."
    },
    "roleDelegateKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["exploration", "implementation", "test", "debug", "review", "security_review"]
      }
    },
    "globalDelegateKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["exploration", "implementation", "test", "debug", "review", "security_review"]
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness", "model", "effort", "max_parallel", "retries",
        "timeout_seconds", "write", "output_limit_chars", "delegate_kinds"
      ],
      "properties": {
        "harness": {"enum": ["claude", "codex"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string"},
        "max_parallel": {
          "type": "integer", "minimum": 1, "maximum": 5,
          "description": "Defaults to 3 for explorer and implementer, 2 for reviewer, and 1 for all other roles."
        },
        "retries": {"type": "integer", "minimum": 0, "maximum": 2},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 14400},
        "write": {"type": "boolean"},
        "output_limit_chars": {"type": "integer", "minimum": 1000, "maximum": 50000},
        "delegate_kinds": {"$ref": "#/$defs/roleDelegateKinds"}
      },
      "allOf": [
        {
          "if": {"properties": {"harness": {"const": "claude"}}, "required": ["harness"]},
          "then": {"properties": {"effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}}}
        },
        {
          "if": {"properties": {"harness": {"const": "codex"}}, "required": ["harness"]},
          "then": {"properties": {"effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}}}
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "delegate_kinds": {"$ref": "#/$defs/globalDelegateKinds"},
        "dirty_worktree_policy": {"$ref": "#/$defs/dirtyPolicy"},
        "mode": {"enum": ["on", "off"]},
        "project_auto_setup": {"type": "boolean"},
        "auto_commit": {"type": "boolean", "description": "Override global auto_commit for the closest matching project."},
        "auto_revival": {"type": "boolean", "description": "Override global auto_revival for the closest matching project."},
        "protected_branches": {"$ref": "#/$defs/uniqueStrings", "description": "Override global protected_branches for the closest matching project; an empty array is allowed."}
      }
    }
  }
}
